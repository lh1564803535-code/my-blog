---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const POSTS_PER_PAGE = 10;
const page = Number(Astro.url.searchParams.get('page')) || 1;
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
const posts = allPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE);
---

<BaseLayout title="dalong's blog" activeNav="home">
  {posts.map((post, index) => (
    <div class="post-item" style={`animation-delay: ${index * 0.1}s`}>
      <p class="post-title">
        <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>{post.data.title}</a>
      </p>
      <p class="post-meta">Posted at {post.data.date.toISOString().split('T')[0]}</p>
      <p class="post-excerpt">{post.data.description}</p>
    </div>
  ))}

  {totalPages > 1 && (
    <div class="pagination">
      {page > 1 && <a href={`?page=${page - 1}`}>&laquo; Prev</a>}
      <span>Page {page} / {totalPages}</span>
      {page < totalPages && <a href={`?page=${page + 1}`}>Next &raquo;</a>}
    </div>
  )}
</BaseLayout>
