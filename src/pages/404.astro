---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found">
  <div style="text-align: center; padding: 100px 0;">
    <h1 style="font-size: 72px; font-weight: 700; margin: 0; color: var(--color-primary);">404</h1>
    <p style="font-size: 18px; color: var(--color-text-light); margin: 16px 0 32px;">Page not found</p>
    <a href="/" style="font-size: 16px;">&larr; Back to Home</a>
  </div>
</BaseLayout>
