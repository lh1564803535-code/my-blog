---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  return 0;
});
---

<BaseLayout title="Projects - dalong" activeNav="projects">
  {allProjects.map((project) => (
    <div class="project-item">
      <p class="project-name">{project.data.name}</p>
      <p class="project-desc">{project.data.description}</p>
      <div class="project-links">
        {project.data.github && (
          <a href={project.data.github} target="_blank" rel="noopener">GitHub</a>
        )}
        {project.data.demo && (
          <a href={project.data.demo} target="_blank" rel="noopener">Demo</a>
        )}
        {project.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
  ))}
</BaseLayout>
