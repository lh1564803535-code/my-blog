---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { readFileSync } from 'fs';
import { resolve } from 'path';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );

  return posts.map((post, index) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: {
      post,
      prevPost: index < posts.length - 1
        ? { slug: posts[index + 1].id.replace(/\.md$/, ''), title: posts[index + 1].data.title }
        : null,
      nextPost: index > 0
        ? { slug: posts[index - 1].id.replace(/\.md$/, ''), title: posts[index - 1].data.title }
        : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout title={`${post.data.title} - dalong`} description={post.data.description}>
  <div class="article-header">
    <h1 class="article-title">{post.data.title}</h1>
    <p class="article-meta">
      {post.data.date.toISOString().split('T')[0]}
      {post.data.tags.length > 0 && (
        <span> · {post.data.tags.join(', ')}</span>
      )}
    </p>
  </div>

  <div class="article-body">
    <Content />
  </div>

  <div class="article-nav">
    {prevPost && (
      <a href={`/blog/${prevPost.slug}`}>&larr; {prevPost.title}</a>
    )}
    {nextPost && (
      <a href={`/blog/${nextPost.slug}`}>{nextPost.title} &rarr;</a>
    )}
  </div>
</BaseLayout>
