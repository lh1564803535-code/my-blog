---
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getCollection, render } from 'astro:content';
import { readFileSync } from 'fs';
import { resolve } from 'path';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
  );

  return posts.map((post, index) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: {
      post,
      prevPost: index < posts.length - 1
        ? { slug: posts[index + 1].id.replace(/\.md$/, ''), title: posts[index + 1].data.title }
        : null,
      nextPost: index > 0
        ? { slug: posts[index - 1].id.replace(/\.md$/, ''), title: posts[index - 1].data.title }
        : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

// Read raw file for word count (use process.cwd() to find source files)
const filePath = resolve(process.cwd(), 'src', 'content', 'blog', post.id);
const rawContent = readFileSync(filePath, 'utf-8');

// Calculate word count (Chinese chars + English words)
const chineseChars = (rawContent.match(/[\u4e00-\u9fff]/g) || []).length;
const englishWords = rawContent.replace(/[\u4e00-\u9fff]/g, '').trim().split(/\s+/).filter(Boolean).length;
const wordCount = chineseChars + englishWords;
---

<BlogPostLayout
  title={post.data.title}
  date={post.data.date}
  tags={post.data.tags}
  description={post.data.description}
  headings={headings}
  wordCount={wordCount}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</BlogPostLayout>
