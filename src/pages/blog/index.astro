---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();

const POSTS_PER_PAGE = 10;
const page = Number(Astro.url.searchParams.get('page')) || 1;
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
const posts = allPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE);
---

<BaseLayout title="Archives - dalong" activeNav="archives">
  <div style="margin-bottom: 24px;">
    {allTags.map((tag) => (
      <span class="tag">{tag}</span>
    ))}
  </div>

  {posts.map((post, index) => (
    <div class="post-item">
      <p class="post-title">
        <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>{post.data.title}</a>
      </p>
      <p class="post-meta">Posted at {post.data.date.toISOString().split('T')[0]}</p>
      <p class="post-excerpt">{post.data.description}</p>
    </div>
  ))}

  {totalPages > 1 && (
    <div class="pagination">
      {page > 1 && <a href={`?page=${page - 1}`}>&laquo; Prev</a>}
      <span>Page {page} / {totalPages}</span>
      {page < totalPages && <a href={`?page=${page + 1}`}>Next &raquo;</a>}
    </div>
  )}
</BaseLayout>
