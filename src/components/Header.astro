---
import { Menu, X } from 'lucide-astro';

const navItems = [
  { label: 'Blog', href: '/blog' },
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
];

const currentPath = Astro.url.pathname;
---

<header style="position: fixed; top: 0; left: 0; right: 0; height: 64px; background: rgba(15, 15, 26, 0.8); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--color-border); z-index: 100; display: flex; align-items: center;" data-astro-transition-persist="header">
  <div style="max-width: 1080px; margin: 0 auto; padding: 0 24px; width: 100%; display: flex; align-items: center; justify-content: space-between;">
    <a href="/" style="font-size: 1.125rem; font-weight: 700; color: var(--color-text-primary); text-decoration: none;" data-astro-transition-persist="logo">
      dalong
    </a>

    <!-- Desktop Nav -->
    <nav style="display: flex; align-items: center; gap: 2rem;">
      <div class="desktop-nav" style="display: flex; gap: 1.5rem;">
        {navItems.map((item) => (
          <a
            href={item.href}
            style={`text-decoration: none; font-size: 0.9rem; font-weight: 500; color: ${currentPath.startsWith(item.href) ? 'var(--color-accent)' : 'var(--color-text-secondary)'}; border-bottom: ${currentPath.startsWith(item.href) ? '2px solid var(--color-accent)' : '2px solid transparent'}; padding-bottom: 2px; transition: color 0.15s;`}
          >
            {item.label}
          </a>
        ))}
      </div>

      <!-- Theme Toggle -->
      <button id="theme-toggle" style="background: none; border: none; cursor: pointer; color: var(--color-text-secondary); display: flex; align-items: center; padding: 0.25rem; transition: color 0.15s;" aria-label="Toggle theme">
        <span class="theme-rotate" id="sun-icon" style="display: none;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        </span>
        <span class="theme-rotate" id="moon-icon" style="display: inline;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </span>
      </button>

      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="mobile-only" style="display: none; background: none; border: none; cursor: pointer; color: var(--color-text-primary); padding: 0.25rem;" aria-label="Open menu">
        <Menu size={24} />
      </button>
    </nav>
  </div>
</header>

<!-- Mobile Drawer -->
<div id="mobile-drawer" style="position: fixed; top: 0; right: -280px; width: 280px; height: 100vh; background: var(--color-bg-secondary); z-index: 200; transition: right 0.3s ease; padding: 1.5rem; display: flex; flex-direction: column;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <span style="font-weight: 700; font-size: 1.125rem;">Menu</span>
    <button id="close-drawer" style="background: none; border: none; cursor: pointer; color: var(--color-text-primary); padding: 0.25rem;">
      <X size={24} />
    </button>
  </div>
  <nav style="display: flex; flex-direction: column; gap: 1.5rem;">
    {navItems.map((item) => (
      <a
        href={item.href}
        style={`text-decoration: none; font-size: 1rem; font-weight: 500; color: ${currentPath.startsWith(item.href) ? 'var(--color-accent)' : 'var(--color-text-primary)'};`}
      >
        {item.label}
      </a>
    ))}
  </nav>
</div>

<!-- Overlay -->
<div id="drawer-overlay" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 150; opacity: 0; pointer-events: none; transition: opacity 0.3s;"></div>

<script is:inline>
  // Theme toggle
  const toggle = document.getElementById('theme-toggle');
  const sunIcon = document.getElementById('sun-icon');
  const moonIcon = document.getElementById('moon-icon');

  function updateThemeIcon() {
    const isDark = document.documentElement.classList.contains('dark');
    if (sunIcon && moonIcon) {
      sunIcon.style.display = isDark ? 'inline' : 'none';
      moonIcon.style.display = isDark ? 'none' : 'inline';
    }
  }

  toggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeIcon();
  });

  updateThemeIcon();

  // Mobile drawer
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const closeDrawerBtn = document.getElementById('close-drawer');
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');

  function openDrawer() {
    if (drawer && overlay) {
      drawer.style.right = '0';
      overlay.style.opacity = '1';
      overlay.style.pointerEvents = 'auto';
    }
  }

  function closeDrawer() {
    if (drawer && overlay) {
      drawer.style.right = '-280px';
      overlay.style.opacity = '0';
      overlay.style.pointerEvents = 'none';
    }
  }

  mobileMenuBtn?.addEventListener('click', openDrawer);
  closeDrawerBtn?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  // Show mobile button on small screens
  function checkMobile() {
    if (mobileMenuBtn) {
      mobileMenuBtn.style.display = window.innerWidth < 768 ? 'flex' : 'none';
    }
  }
  checkMobile();
  window.addEventListener('resize', checkMobile);

  // Re-run after View Transitions
  document.addEventListener('astro:after-swap', () => {
    checkMobile();
  });
</script>

<style>
  .desktop-nav {
    display: flex;
  }
  .mobile-only {
    display: none;
  }
  @media (max-width: 768px) {
    .desktop-nav {
      display: none !important;
    }
    .mobile-only {
      display: flex !important;
    }
  }
</style>
