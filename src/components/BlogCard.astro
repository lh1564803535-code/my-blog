---
interface Props {
  title: string;
  date: Date;
  description: string;
  tags: string[];
  slug: string;
  index?: number;
}

const { title, date, description, tags, slug, index = 0 } = Astro.props;
const formattedDate = date.toISOString().split('T')[0];
const delay = index * 100;
---

<a href={`/blog/${slug}`} class="card-animate card-shadow" data-blog-card data-title={title} data-description={description} data-tags={tags.join(',')} data-slug={slug} style={`display: block; padding: 1.5rem; background: var(--color-bg-card); border-radius: 12px; text-decoration: none; color: var(--color-text-primary); transition: all 0.15s; animation-delay: ${delay}ms;`}
  onmouseover="this.style.transform='translateY(-2px)'; this.style.borderColor='var(--color-accent)'"
  onmouseout="this.style.transform=''; this.style.borderColor='var(--color-border)'"
>
  <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--color-text-secondary); font-size: 0.8rem; margin-bottom: 0.5rem;">
    {formattedDate}
  </div>
  <h3 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">{title}</h3>
  <p style="color: var(--color-text-secondary); font-size: 0.9rem; margin-bottom: 0.75rem; line-height: 1.6;">{description.slice(0, 80)}{description.length > 80 ? '...' : ''}</p>
  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
    {tags.map((tag) => (
      <span style="background: var(--color-bg-secondary); color: var(--color-accent); padding: 0.2rem 0.6rem; border-radius: 8px; font-size: 0.7rem;">{tag}</span>
    ))}
  </div>
</a>
