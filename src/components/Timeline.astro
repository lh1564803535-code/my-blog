---
interface TimelineItem {
  period: string;
  title: string;
  description?: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<div style="position: relative; padding-left: 2rem;">
  <div style="position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--color-border);"></div>
  {items.map((item, index) => (
    <div style={`position: relative; padding-bottom: ${index < items.length - 1 ? '2rem' : '0'};`}>
      <div style="position: absolute; left: -2rem; top: 0.25rem; width: 10px; height: 10px; border-radius: 50%; background: var(--color-accent); transform: translateX(-4px);"></div>
      <div style="font-size: 0.8rem; color: var(--color-text-secondary); margin-bottom: 0.25rem;">{item.period}</div>
      <div style="font-weight: 600; margin-bottom: 0.25rem;">{item.title}</div>
      {item.description && (
        <div style="color: var(--color-text-secondary); font-size: 0.9rem;">{item.description}</div>
      )}
    </div>
  ))}
</div>
