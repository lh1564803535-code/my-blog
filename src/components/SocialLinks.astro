---
import { Github, Twitter, Mail, Link } from 'lucide-astro';

interface Props {
  github?: string;
  twitter?: string;
  email?: string;
  website?: string;
}

const { github, twitter, email, website } = Astro.props;
---

<div style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
  {github && (
    <a href={github} target="_blank" rel="noopener" style="display: flex; align-items: center; gap: 0.5rem; color: var(--color-text-secondary); text-decoration: none; font-size: 0.9rem; transition: color 0.15s;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='var(--color-text-secondary)'">
      <Github size={18} />
      GitHub
    </a>
  )}
  {twitter && (
    <a href={twitter} target="_blank" rel="noopener" style="display: flex; align-items: center; gap: 0.5rem; color: var(--color-text-secondary); text-decoration: none; font-size: 0.9rem; transition: color 0.15s;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='var(--color-text-secondary)'">
      <Twitter size={18} />
      Twitter/X
    </a>
  )}
  {email && (
    <a href={`mailto:${email}`} style="display: flex; align-items: center; gap: 0.5rem; color: var(--color-text-secondary); text-decoration: none; font-size: 0.9rem; transition: color 0.15s;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='var(--color-text-secondary)'">
      <Mail size={18} />
      Email
    </a>
  )}
  {website && (
    <a href={website} target="_blank" rel="noopener" style="display: flex; align-items: center; gap: 0.5rem; color: var(--color-text-secondary); text-decoration: none; font-size: 0.9rem; transition: color 0.15s;" onmouseover="this.style.color='var(--color-accent)'" onmouseout="this.style.color='var(--color-text-secondary)'">
      <Link size={18} />
      Website
    </a>
  )}
</div>
