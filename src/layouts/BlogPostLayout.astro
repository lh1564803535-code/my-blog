---
import BaseLayout from './BaseLayout.astro';
import TOC from '../components/TOC.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import { Calendar, Clock, Tag } from 'lucide-astro';

interface Props {
  title: string;
  date: Date;
  tags: string[];
  description: string;
  headings: { depth: number; slug: string; text: string }[];
  wordCount: number;
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
}

const { title, date, tags, description, headings, wordCount, prevPost, nextPost } = Astro.props;
const readingTime = Math.max(1, Math.ceil(wordCount / 300));
const formattedDate = date.toISOString().split('T')[0];

// JSON-LD for blog post
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": date.toISOString(),
  "author": {
    "@type": "Person",
    "name": "dalong"
  },
  "publisher": {
    "@type": "Person",
    "name": "dalong"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://lh1564803535-code.github.io/blog/${Astro.url.pathname.split('/').filter(Boolean).pop()}/`
  }
};
---

<BaseLayout title={`${title} - dalong Blog`} description={description} type="article">
  <ReadingProgress />

  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article style="max-width: 720px; margin: 0 auto;">
    <!-- Article Header -->
    <header style="margin-bottom: 2rem;">
      <h1 style="font-size: 2rem; font-weight: 700; margin-bottom: 0.75rem; line-height: 1.3;">{title}</h1>
      <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; color: var(--color-text-secondary); font-size: 0.875rem;">
        <span style="display: flex; align-items: center; gap: 0.25rem;">
          <Calendar size={16} />
          {formattedDate}
        </span>
        <span style="display: flex; align-items: center; gap: 0.25rem;">
          <Clock size={16} />
          {readingTime} min read
        </span>
        <span style="color: var(--color-text-secondary);">
          {wordCount.toLocaleString()} words
        </span>
      </div>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem;">
        {tags.map((tag) => (
          <span style="display: inline-flex; align-items: center; gap: 0.25rem; background: var(--color-bg-secondary); color: var(--color-accent); padding: 0.25rem 0.75rem; border-radius: 8px; font-size: 0.75rem;">
            <Tag size={12} />
            {tag}
          </span>
        ))}
      </div>
    </header>

    <!-- Article Body with TOC sidebar on desktop -->
    <div style="display: flex; gap: 2rem; position: relative;">
      <div class="prose" style="flex: 1; min-width: 0; max-width: 720px;">
        <slot />
      </div>
      {headings.length > 0 && (
        <aside class="toc-sidebar hidden lg:block" style="width: 220px; flex-shrink: 0;">
          <TOC headings={headings} />
        </aside>
      )}
    </div>

    <!-- Prev/Next Navigation -->
    <nav style="display: flex; gap: 1rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border);">
      {prevPost && (
        <a href={`/blog/${prevPost.slug}`} style="flex: 1; padding: 1rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 12px; text-decoration: none; color: var(--color-text-primary); transition: all 0.15s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.borderColor='var(--color-accent)'" onmouseout="this.style.transform=''; this.style.borderColor='var(--color-border)'">
          <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--color-text-secondary); font-size: 0.8rem; margin-bottom: 0.25rem;">
            &#8592; Prev
          </div>
          <div style="font-weight: 600; font-size: 0.95rem;">{prevPost.title}</div>
        </a>
      )}
      {nextPost && (
        <a href={`/blog/${nextPost.slug}`} style="flex: 1; padding: 1rem; background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 12px; text-decoration: none; color: var(--color-text-primary); text-align: right; transition: all 0.15s;" onmouseover="this.style.transform='translateY(-2px)'; this.style.borderColor='var(--color-accent)'" onmouseout="this.style.transform=''; this.style.borderColor='var(--color-border)'">
          <div style="display: flex; align-items: center; justify-content: flex-end; gap: 0.5rem; color: var(--color-text-secondary); font-size: 0.8rem; margin-bottom: 0.25rem;">
            Next &#8594;
          </div>
          <div style="font-weight: 600; font-size: 0.95rem;">{nextPost.title}</div>
        </a>
      )}
    </nav>
  </article>

  <style>
    .toc-sidebar {
      position: sticky;
      top: 80px;
      align-self: flex-start;
    }
  </style>
</BaseLayout>
